      #lab 6
  print("=== GPA ЕСЕПТЕГІШІ ===")

subjects = int(input("Пәндер саны қанша? "))

total_points = 0
total_credits = 0

for i in range(subjects):
    print(f"\n{i + 1}-пән")

    name = input("Пәннің атауын енгіз: ")
    grade = float(input("Бағаны енгіз (0-100): "))
    credits = float(input("Кредит санын енгіз: "))

    if grade < 0 or grade > 100 or credits <= 0:
        print("Қате! Баға 0-100 аралығында, ал кредит 0-ден үлкен болуы керек.")
        continue

    gpa_grade = (grade / 100) * 4

    total_points += gpa_grade * credits
    total_credits += credits
if total_credits > 0:
    gpa = total_points / total_credits
    print("Сенің GPA көрсеткішің:", round(gpa, 2), "/ 4.00")
else:
    print("GPA есептеу мүмкін емес.")


      #lab 7
      passed = []
failed = []

n = int(input("Студенттер саны қанша? "))

for i in range(n):
    name = input("Студенттің атын енгіз: ")
    score = int(input("Студенттің балын енгіз: "))

    if score >= 50:
        passed.append({"Аты": name, "Балы": score})
    else:
        failed.append({"Аты": name, "Балы": score})

print("ӨТКЕН СТУДЕНТТЕР")
for student in passed:
    print(student["Аты"], "-", student["Балы"], "балл")

print("ӨТПЕГЕН СТУДЕНТТЕР")
for student in failed:
    print(student["Аты"], "-", student["Балы"], "балл")
